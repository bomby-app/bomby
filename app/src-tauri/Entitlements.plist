<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Signed builds run with hardened runtime (Tauri's default), which blocks the mic
       unless the app holds this. macOS still asks the user (NSMicrophoneUsageDescription in
       Info.plist). Applied only when the app is signed: `just app build` with the APPLE_*
       variables (docs/releasing.md). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
