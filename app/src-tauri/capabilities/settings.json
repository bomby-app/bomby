{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: setup, agents, voice, appearance and credentials (the first-run splash in the main window reads and saves credentials too).",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-close",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-credentials-info",
    "allow-save-credentials",
    "allow-clear-credentials",
    "allow-has-gemini-key",
    "allow-save-gemini-key",
    "allow-clear-gemini-key",
    "allow-agents-status",
    "allow-refresh-agents",
    "allow-install-adapters",
    "allow-voice-settings",
    "allow-set-voice"
  ]
}
