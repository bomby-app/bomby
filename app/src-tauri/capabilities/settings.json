{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: setup, intro, agents, voice, memory, extensions, call server, appearance and about, with Export Diagnostics (the first-run splash in the main window reads and saves credentials too).",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://bomby.app" },
        { "url": "https://github.com/bomby-app/bomby" },
        { "url": "https://github.com/bomby-app/bomby/blob/main/LICENSE" },
        { "url": "https://x.com/AbuRadyx" },
        { "url": "https://code.claude.com/docs/en/quickstart" },
        { "url": "https://learn.chatgpt.com/docs/codex/cli" },
        { "url": "https://opencode.ai/docs/" },
        { "url": "https://omp.sh/docs/quickstart" },
        { "url": "https://goose-docs.ai/docs/quickstart/" },
        { "url": "https://app.getzep.com" },
        { "url": "https://aistudio.google.com/apikey" },
        { "url": "https://platform.openai.com/api-keys" },
        { "url": "https://app.rime.ai/tokens" },
        { "url": "https://mcp.zapier.com" },
        { "url": "https://connect.composio.dev" }
      ]
    },
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-credentials-info",
    "allow-read-keys-again",
    "allow-save-credentials",
    "allow-clear-credentials",
    "allow-save-voice-key",
    "allow-clear-voice-key",
    "allow-has-zep-key",
    "allow-save-zep-key",
    "allow-clear-zep-key",
    "allow-agent-keys",
    "allow-save-agent-key",
    "allow-clear-agent-key",
    "allow-memory-setting",
    "allow-set-memory-setting",
    "allow-memory-incognito",
    "allow-set-memory-incognito",
    "allow-livekit-server",
    "allow-set-livekit-server",
    "allow-agents-status",
    "allow-refresh-agents",
    "allow-agent-settings",
    "allow-pick-agent-settings",
    "allow-install-adapters",
    "allow-voice-settings",
    "allow-set-voice-provider",
    "allow-set-voice",
    "allow-set-voice-option",
    "allow-user-name",
    "allow-set-user-name",
    "allow-tone",
    "allow-set-tone",
    "allow-extensions-settings",
    "allow-set-extension",
    "allow-connect-extension",
    "allow-cancel-extension-connect",
    "allow-disconnect-extension",
    "allow-about",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-export-diagnostics",
    "allow-show-diagnostics"
  ]
}
