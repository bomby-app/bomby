{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: setup, intro, agents, voice, appearance, credentials and about (the first-run splash in the main window reads and saves credentials too).",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/bomby-app/bomby" }]
    },
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-credentials-info",
    "allow-save-credentials",
    "allow-clear-credentials",
    "allow-has-gemini-key",
    "allow-save-gemini-key",
    "allow-clear-gemini-key",
    "allow-livekit-server",
    "allow-set-livekit-server",
    "allow-agents-status",
    "allow-refresh-agents",
    "allow-agent-settings",
    "allow-pick-agent-settings",
    "allow-install-adapters",
    "allow-voice-settings",
    "allow-set-voice",
    "allow-user-name",
    "allow-set-user-name",
    "allow-about",
    "allow-check-for-updates",
    "allow-install-update"
  ]
}
