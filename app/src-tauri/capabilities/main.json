{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: projects and the call, which it reports to the menu bar icon.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://cloud.livekit.io" },
        { "url": "https://aistudio.google.com/apikey" }
      ]
    },
    "dialog:allow-open",
    "allow-open-settings",
    "allow-set-tray-status",
    "allow-task-finished",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-delete-project",
    "allow-open-call",
    "allow-call-token",
    "allow-end-call",
    "allow-save-message",
    "allow-call-messages",
    "allow-app-log",
    "allow-delete-call",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "allow-credentials-info",
    "allow-save-credentials",
    "allow-clear-credentials",
    "allow-has-gemini-key",
    "allow-save-gemini-key",
    "allow-clear-gemini-key",
    "allow-agents-status",
    "allow-refresh-agents",
    "allow-install-adapters",
    "allow-first-run",
    "allow-finish-first-run"
  ]
}
