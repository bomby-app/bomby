{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: projects and the call, which it reports to the menu bar icon.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://cloud.livekit.io" },
        { "url": "https://aistudio.google.com/apikey" },
        { "url": "https://platform.openai.com/api-keys" },
        { "url": "https://app.rime.ai/tokens" },
        { "url": "https://code.claude.com/docs/en/quickstart" },
        { "url": "https://learn.chatgpt.com/docs/codex/cli" },
        { "url": "https://opencode.ai/docs/" },
        { "url": "https://omp.sh/docs/quickstart" },
        { "url": "https://goose-docs.ai/docs/quickstart/" }
      ]
    },
    "dialog:allow-open",
    "allow-open-settings",
    "allow-set-tray-status",
    "allow-task-finished",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-set-project-agents",
    "allow-set-project-extensions",
    "allow-extensions-settings",
    "allow-open-extension-link",
    "allow-list-todos",
    "allow-add-todos",
    "allow-update-todo",
    "allow-remove-todo",
    "allow-delete-project",
    "allow-open-call",
    "allow-call-token",
    "allow-end-call",
    "allow-save-message",
    "allow-call-messages",
    "allow-app-log",
    "allow-delete-call",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "allow-credentials-info",
    "allow-save-credentials",
    "allow-clear-credentials",
    "allow-save-voice-key",
    "allow-voice-settings",
    "allow-set-voice-provider",
    "allow-livekit-server",
    "allow-set-livekit-server",
    "allow-agents-status",
    "allow-refresh-agents",
    "allow-agent-settings",
    "allow-pick-agent-settings",
    "allow-install-adapters",
    "allow-first-run",
    "allow-finish-first-run",
    "allow-folder-info",
    "allow-folder-changes",
    "allow-folder-entries",
    "allow-folder-file",
    "allow-folder-image",
    "allow-watch-folder",
    "allow-unwatch-folder",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close"
  ]
}
