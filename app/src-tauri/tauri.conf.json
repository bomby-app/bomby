{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bomby",
  "version": "0.1.0",
  "identifier": "app.bomby.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bomby",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 30
        },
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGRDQyRTA3RTYzRTA4MDQKUldRRUNEN21CeTdVendja0RkWVdqN0w3dGVlQ1lnT0RJTExOSjVwMlRGM0JmYmVmSFVTakNHQngK",
      "endpoints": [
        "https://github.com/bomby-app/bomby/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car",
        "Resources/agent": "../../agent/dist/bomby-agent"
      },
      "dmg": {
        "background": "icons/dmg-background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    }
  }
}
