# Who the console talks through: gemini (default), openai or rime.
# VOICE_PROVIDER=gemini

# Gemini model: "fast" -> gemini-3.8-live, "thinking" -> gemini-3.8-live-extended-thinking
MODEL=fast
# Thinking depth for MODEL=thinking: low (default, fastest), medium or high. Ignored for fast.
# THINKING_LEVEL=low

# Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Optional Gemini voice (default: Leda)
# GEMINI_VOICE=Leda

# OpenAI API key on a paid tier, for VOICE_PROVIDER=openai (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional GPT-Live voice: gleam (default), or another natural voice in voice_providers/openai.py
# OPENAI_VOICE=gleam

# Rime API key, for VOICE_PROVIDER=rime (https://app.rime.ai/tokens)
RIME_API_KEY=
# Optional Prism voice: aurora (default), wawona, brando or astra
# RIME_VOICE=aurora

# Claude Code's ACP adapter. Defaults to the one `just agent install` builds in adapters/bin.
# Claude runs signed in with your Claude plan (`claude` login); ANTHROPIC_API_KEY is never
# passed to it, and neither is anything in this file.
# CLAUDE_ACP_BIN=/path/to/claude-agent-acp

# Codex CLI's ACP adapter, built there too. It runs your own `codex` on your Codex login.
# CODEX_ACP_BIN=/path/to/codex-acp

# The project for console runs (the app sends it in the dispatch metadata instead).
# Folders are absolute and separated by ":" (";" on Windows); the first is the agents'
# working directory. Default: the home folder. The instructions are what the user wrote
# about the project; leave them out to say nothing.
# BOMBY_PROJECT=samba
# BOMBY_FOLDERS=/Users/you/Dev/samba:/Users/you/Dev/shared
# BOMBY_INSTRUCTIONS="A music app: the API is in Go, the site in Svelte."

# What the voice agent calls you on console runs (the app sends it from Settings, Bomby).
# BOMBY_USER_NAME=Sam

# Bomby's tone on console runs: sharp (default), chatty or playful (prompts/<tone>.md).
# BOMBY_TONE=playful

# Memory across calls on console runs: a Zep key and the user to remember as (the app sends
# the user when Settings, Memory is on).
# ZEP_API_KEY=
# BOMBY_MEMORY_USER=bomby-console
# Read memory but save nothing from the call:
# BOMBY_MEMORY_INCOGNITO=1

# Debugging: dump raw Gemini Live messages. Set in the shell, not here: the plugin
# reads it at import time, before .env is loaded.
# LK_GOOGLE_DEBUG=1

# LiveKit credentials - not needed for `console` mode, required for `dev` / `start`
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
